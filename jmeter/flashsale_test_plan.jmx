      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="场景1：秒杀核心场景（1000并发抢购500件商品）">
        <stringProp name="TestPlan.comments">模拟1000个用户同时抢购500件商品

预期结果：
- 成功订单数 = 库存数（100）
- 无超卖（成功订单 &lt;= 库存数）
- 无重复订单
- 观察TPS和P99延迟</stringProp>
        <intProp name="ThreadGroup.num_threads">1000</intProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="循环控制器">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="读取用户Token" enabled="true">
